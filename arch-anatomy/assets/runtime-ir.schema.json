{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "shape": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                }
              ]
            }
          },
          "dtype": {
            "enum": [
              "float64"
            ]
          }
        },
        "required": [
          "id",
          "shape",
          "dtype"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "number"
              }
            }
          },
          "trainable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "value",
          "trainable"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "op": {
            "enum": [
              "identity",
              "scale",
              "relu",
              "tanh",
              "linear",
              "add",
              "matmul",
              "transpose",
              "softmax",
              "reshape",
              "concat",
              "layernorm"
            ]
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "attributes": {
            "type": "object"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "op",
          "inputs",
          "attributes",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    }
  },
  "required": [
    "schema_version",
    "inputs",
    "parameters",
    "nodes",
    "outputs"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-04/schema#"
}
