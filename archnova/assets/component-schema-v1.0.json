{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "component_id",
    "name",
    "functional_group",
    "operator_family",
    "equation",
    "input_space",
    "output_space",
    "discretization",
    "parallelism",
    "parameters",
    "invariants",
    "symmetry",
    "stability_conditions",
    "replacement_candidates",
    "tags",
    "verification_refs",
    "interface",
    "complexity",
    "provenance",
    "implementation_refs",
    "verification_status"
  ],
  "properties": {
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "functional_group": {
      "type": "string",
      "minLength": 1
    },
    "operator_family": {
      "type": "string",
      "minLength": 1
    },
    "equation": {
      "type": "string",
      "minLength": 1
    },
    "input_space": {
      "type": "string",
      "minLength": 1
    },
    "output_space": {
      "type": "string",
      "minLength": 1
    },
    "discretization": {
      "type": "string",
      "minLength": 1
    },
    "parallelism": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "symmetry": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stability_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "replacement_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "interface": {
      "type": "object",
      "required": [
        "input_shape",
        "output_shape",
        "state",
        "dtype",
        "layout"
      ],
      "properties": {
        "input_shape": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "output_shape": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "complexity": {
      "type": "object",
      "required": [
        "time",
        "memory",
        "assumptions"
      ],
      "properties": {
        "time": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref",
          "locator"
        ],
        "properties": {
          "kind": {
            "enum": [
              "paper_fact",
              "code_observed",
              "derived",
              "proposed"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "implementation_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "locator",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "reference",
              "observed",
              "tested"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "verification_status": {
      "enum": [
        "unverified",
        "partially_verified",
        "verified"
      ]
    }
  },
  "additionalProperties": false
}
